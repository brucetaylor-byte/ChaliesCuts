# Copy this file to .env and fill in real values. .env is git-ignored, so
# your credentials never get committed or pushed to GitHub.

# --- Booking confirmation emails (optional) ---
# Sends booking confirmed/declined/cancelled emails to customers, and new-
# request emails to stylists, via Resend (https://resend.com) - a
# transactional email API over plain HTTPS. Leave RESEND_API_KEY blank/unset
# to disable email sending entirely - the app works fine without it, emails
# are just skipped.
#
# Why Resend instead of sending straight from a Gmail account: raw SMTP
# (which is what emailing "from Gmail" requires) is commonly throttled or
# blocked outright by cloud hosts to fight spam abuse, which made delivery
# unreliable when we tried it. A plain HTTPS API call doesn't hit that.
#
# Setup:
#   1. Create a free account at https://resend.com (3,000 emails/month free,
#      no card required).
#   2. Verify a sending domain under Domains (e.g. charlies-cuts.com) - or
#      for quick testing, skip this and use the default
#      "onboarding@resend.dev" sender below, though that can only send to
#      your own Resend account email until a domain is verified.
#   3. Create an API key under API Keys and paste it below.
RESEND_API_KEY=re_yourapikey

# Who emails appear to come from - must be either onboarding@resend.dev, or
# an address at a domain you've verified in Resend (e.g.
# "Charlie's Cuts <bookings@charlies-cuts.com>").
EMAIL_FROM=Charlie's Cuts <onboarding@resend.dev>

# --- Session security ---
# A random long string used to sign session cookies. Only matters once
# you're running this somewhere other than your own machine for testing.
SESSION_SECRET=dev-secret-change-me

# --- Persistent storage location (only needed when deployed live) ---
# Leave unset when running locally - data/ and uploads/ just live in this
# project folder as normal. When deployed to a host, set this to wherever
# that host's persistent volume/disk is mounted (e.g. /app/storage on
# Railway) so the database and gallery photos survive deploys and restarts
# instead of being wiped each time. See README "Deploying live".
# DATA_DIR=/app/storage
