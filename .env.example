# Copy this file to .env and fill in real values. .env is git-ignored, so
# your credentials never get committed or pushed to GitHub.

# --- Booking confirmation emails (optional) ---
# Sends booking confirmed/declined/cancelled emails to customers, from your
# own Gmail account. Leave these blank/unset to disable email sending
# entirely - the app works fine without them, emails are just skipped.
#
# How to get an app password (needed because Gmail won't accept your normal
# login password for this):
#   1. Go to https://myaccount.google.com/security
#   2. Turn on "2-Step Verification" if it isn't already on.
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Create a new app password (name it e.g. "Charlie's Cuts booking app")
#   5. Paste the 16-character password below (spaces don't matter).
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# What name emails appear to come from (the address is always GMAIL_USER above).
EMAIL_FROM_NAME=Charlie's Cuts

# --- Session security ---
# A random long string used to sign session cookies. Only matters once
# you're running this somewhere other than your own machine for testing.
SESSION_SECRET=dev-secret-change-me

# --- Persistent storage location (only needed when deployed live) ---
# Leave unset when running locally - data/ and uploads/ just live in this
# project folder as normal. When deployed to a host, set this to wherever
# that host's persistent volume/disk is mounted (e.g. /app/storage on
# Railway) so the database and gallery photos survive deploys and restarts
# instead of being wiped each time. See README "Deploying live".
# DATA_DIR=/app/storage
